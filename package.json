{
  "name": "rolcam",
  "version": "1.1.0",
  "description": "Avatar de personaje por cámara para partidas de rol online",
  "main": "main.js",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "recursos": "node scripts/descargar-recursos.js",
    "postinstall": "node scripts/copiar-librerias.js && node scripts/descargar-recursos.js",
    "instalador": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@pixiv/three-vrm": "3.5.5",
    "kalidokit": "1.1.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "electron": "^45.3.0"
  },
  "author": "juanmstorni-bot",
  "build": {
    "appId": "io.github.juanmstorni-bot.rolcam",
    "productName": "RolCam",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!nativo/*.cpp",
      "!nativo/*.yml",
      "!scripts",
      "!.github",
      "!docs",
      "!dist",
      "!_*",
      "!instalador"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "RolCam",
      "include": "instalador/camara.nsh"
    },
    "linux": {
      "target": "dir"
    }
  }
}
